DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_BIND_ADDRESS=127.0.0.1
DJANGO_HOST_PORT=8000
POSTGRES_DB=aluguel_carro
POSTGRES_USER=aluguel_carro
