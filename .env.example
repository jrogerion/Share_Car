POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5
DB_WAIT_TIMEOUT=60

# E-mail para recuperação de senha. Em DEBUG, o padrão exibe o link no console.
# Para usar SMTP, descomente e preencha:
